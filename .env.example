# Compose-first defaults: `db`, `redis`, and `minio` are Docker Compose service names.
# For native host services, override them with `localhost` as documented in README.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:postgres@db:5432/syco23
ENVIRONMENT=local
REPOSITORY_MODE=postgres
AUTH_MODE=local
LOCAL_USER_ROLE=admin
YOUTUBE_API_KEY=
ARCHIVE_ORG_ENABLED=false
MIXCLOUD_ENABLED=false
AUDIUS_ENABLED=false
AUDIUS_API_BEARER_TOKEN=
RSS_ENABLED=false
RSS_TRUSTED_FEEDS_JSON=
SCRAPER_USER_AGENT=syco23-setcrawler/0.1 (+contact: you@example.com)
SCRAPER_REQUEST_DELAY_MS=5000
FTM_SCRAPER_ENABLED=false
FTM_MAX_PAGES_PER_RUN=25
YT_DLP_BIN=yt-dlp
REDIS_URL=redis://redis:6379/0
JOB_CLAIM_TTL_SECONDS=300
JOB_REDRIVE_INTERVAL_SECONDS=60
JOB_REDRIVE_BATCH_SIZE=100
PROVIDER_MODE=fixture
PROVIDER_REQUEST_TIMEOUT_SECONDS=20
PROVIDER_OUTPUT_LIMIT_BYTES=1048576

# Private MinIO storage is provisioned internally but remains disabled for API use
# until an authorized acquisition or upload flow explicitly enables it.
AUDIO_STORAGE_ENABLED=false
MINIO_ROOT_USER=syco23-local
MINIO_ROOT_PASSWORD=syco23-local-minio-change-me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=syco23-local
MINIO_SECRET_KEY=syco23-local-minio-change-me
MINIO_SECURE=false
AUDIO_MAX_OBJECT_BYTES=4294967296
AUDIO_MULTIPART_PART_SIZE_BYTES=16777216

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_RUNTIME_MODE=local
NUXT_PUBLIC_LOCAL_ROLE=admin
