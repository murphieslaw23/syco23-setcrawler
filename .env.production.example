# Public routing
API_DOMAIN=api-setcrawler.example.com
ACME_EMAIL=operations@example.com
CORS_ORIGINS=https://syco23-setcrawler.vercel.app

# Supabase project configuration. Keep DATABASE_URL server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Safe initial mode. Provider requests return 409 while this remains fixture.
PROVIDER_MODE=fixture
YOUTUBE_API_KEY=
ARCHIVE_ORG_ENABLED=false
MIXCLOUD_ENABLED=false
AUDIUS_ENABLED=false
AUDIUS_API_BEARER_TOKEN=
RSS_ENABLED=false
# JSON object keyed by exact HTTPS feed URL. Each value requires
# {"evidence_url":"https://...","license":"CC-BY-4.0"}.
RSS_TRUSTED_FEEDS_JSON=
SCRAPER_USER_AGENT=syco23-setcrawler/0.2 (+contact: operations@example.com)
SCRAPER_REQUEST_DELAY_MS=5000
FTM_SCRAPER_ENABLED=false
FTM_MAX_PAGES_PER_RUN=25
PROVIDER_REQUEST_TIMEOUT_SECONDS=20
PROVIDER_OUTPUT_LIMIT_BYTES=1048576
YT_DLP_BIN=yt-dlp

# All-provider live activation requires complete credentials and explicit flags.
# Set these values in the host-only .env.production file:
# PROVIDER_MODE=live
# YOUTUBE_API_KEY=<server-side YouTube Data API key>
# ARCHIVE_ORG_ENABLED=true
# MIXCLOUD_ENABLED=true
# AUDIUS_ENABLED=true
# AUDIUS_API_BEARER_TOKEN=<server-side Audius bearer token>
# RSS_ENABLED=true
# RSS_TRUSTED_FEEDS_JSON={"https://example.org/feed.xml":{"evidence_url":"https://example.org/license","license":"CC-BY-4.0"}}
# FTM_SCRAPER_ENABLED=true
#
# Activate only with a one-time invocation acknowledgement; do not persist the
# acknowledgement in .env.production:
# PROVIDER_ACTIVATION_ACK=activate-all ./scripts/deploy-production.sh api.syco23.org

# Internal-only MinIO. Generate independent high-entropy values and keep the
# API storage feature disabled until an authorized acquisition path is deployed.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
AUDIO_STORAGE_ENABLED=false
AUDIO_MAX_OBJECT_BYTES=4294967296
AUDIO_MULTIPART_PART_SIZE_BYTES=16777216

# Durable recovery
JOB_CLAIM_TTL_SECONDS=300
JOB_REDRIVE_INTERVAL_SECONDS=60
JOB_REDRIVE_BATCH_SIZE=100

# Operational readiness and aggregate alert thresholds. These values contain
# no credentials and may be copied into deployment evidence.
HEALTH_PROBE_TIMEOUT_SECONDS=1
HEALTH_PROBE_CACHE_SECONDS=10
BEAT_STALE_AFTER_SECONDS=180
DEAD_LETTER_ALERT_THRESHOLD=1
STUCK_JOB_ALERT_THRESHOLD=1
REDRIVE_FAILURE_ALERT_THRESHOLD=1
PROVIDER_FAILURE_ALERT_THRESHOLD=1
